---
import AdminOrdersLayout from "@/layouts/AdminOrdersLayout.astro";
import {orderStatusOptions} from '@/utils/constants'
import OrderList from "@/components/admin/orders/OrderList";
const {status} = Astro.params
const currentStatus  = orderStatusOptions.filter(s =>s.value === status)[0]
---

<AdminOrdersLayout title=`Administrar Ordenes - ${currentStatus.value}`>
    <OrderList
        client:only="react"
        status={currentStatus.value}
    />
</AdminOrdersLayout>
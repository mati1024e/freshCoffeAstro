---
import AdminProductLayout from "@/layouts/AdminProductLayout.astro";
import ProductsTable from "@/components/admin/products/ProductsTable.astro";
import { ProductsSchema } from "@/types/products.schema";
const PRODUCTS_PER_PAGE = 10
const PAGE=Astro.url.searchParams.get('page') ?? 1

const {category} = Astro.params

const res = await fetch(`${import.meta.env.API_URL}/freshcoffee_products?per_page=${PRODUCTS_PER_PAGE}&page=${PAGE}&freshcoffee_category_slug=${category}`)

if(!res.ok) return Astro.redirect('/admin/products?page=1')

const data = await res.json()
const products = ProductsSchema.parse(data)

const totalPages = res.headers.get('X-WP-TotalPages')

// if(!statusRes) return Astro.redirect('/admin/products?page=1')
---

<AdminProductLayout 
    title="Administrar Productos" 
    page={+PAGE} 
    totalPages={+totalPages!}
>
    <ProductsTable products={products} />
</AdminProductLayout>
---
import { Picture } from 'astro:assets';
import  PriceWithVariant from './PriceWithVariant.astro'
import {formatCurrency} from '@/utils'
import type {Product, ProductWithVariablePrice} from '@/types'
import AddProductButton from './AddProductButton';
interface Props{
    product:Product;
}
const {product} = Astro.props
const {id,title,featured_images,acf} = product 
// console.log(product)

---

<div class="border border-gray-200 ">
    <div class="p-5">
        <Picture 
            src={featured_images.full.url}
            width={featured_images.full.width}
            height={featured_images.full.height}
            alt={`Imagen del ${title.rendered}`}
            formats={['avif','webp']}
        />
        <h3 class="text-2xl font-black ">{title.rendered}</h3>
        {acf.variable_price ? <PriceWithVariant product={product as ProductWithVariablePrice} /> : (
            <p class="mt-5 font-black text-amber-400 text-4xl">
                {formatCurrency(acf.price)}
            </p>
            <AddProductButton
                client:only="react"
                product ={{
                    id,
                    name:title.rendered,
                    price:acf.price
                }}
            />
        )}

    </div>
</div>
---
import { Picture } from 'astro:assets';
import type {Product} from '@/types'
interface Props{
    product:Product;
}
const {product} = Astro.props
const {title,featured_images} = product 
---

<div class="border border-gray-200 ">
    <div class="p-5">
        <Picture 
            src={featured_images.full.url}
            width={featured_images.full.width}
            height={featured_images.full.height}
            alt={`Imagen del ${title.rendered}`}
            formats={['avif','webp']}
        />
        <h3 class="text-2xl font-black ">{title.rendered}</h3>

    </div>
</div>